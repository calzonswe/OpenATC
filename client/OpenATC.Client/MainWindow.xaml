<Window x:Class="OpenATC.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenATC Client" Height="400" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Bar -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="8" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ConnectionStatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Margin="8,0,8,0"/>
                <TextBlock x:Name="PttStatusText" Text="PTT: Idle" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- PTT Indicator -->
        <Border Grid.Row="1" x:Name="PttIndicator" Background="#e0e0e0" Padding="8" CornerRadius="4" Margin="0,0,0,8">
            <TextBlock x:Name="PttIndicatorText" Text="Press PTT to speak" 
                       HorizontalAlignment="Center" FontWeight="SemiBold"/>
        </Border>

        <!-- ATC Log -->
        <Border Grid.Row="2" Background="#1a1a2e" Padding="8" CornerRadius="4" Margin="0,0,0,4">
            <TextBlock Text="ATC COMMUNICATIONS" Foreground="#e0e0e0" 
                       FontSize="11" FontFamily="Consolas" LetterSpacing="2"/>
        </Border>
        <ListBox Grid.Row="3" x:Name="AtcLog" 
                 Background="#0d0d1a" Foreground="#00ff88"
                 FontFamily="Consolas" FontSize="13"
                 BorderThickness="1" BorderBrush="#333"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AlternationCount="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Controls -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="SettingsButton" Content="⚙ Settings" 
                    Width="100" Height="30" Click="OnSettingsClick" Margin="0,0,8,0"/>
            <TextBlock x:Name="CallingIndicator" Text="" 
                       VerticalAlignment="Center" Foreground="#cc8800"
                       FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
