# OpenATC Environment Configuration
# Copy this file to .env and uncomment/change values as needed.

# Server
# SERVER_PORT=8765
# SERVER_HOST=0.0.0.0
# SERVER_LOG_LEVEL=info

# LLM (Ollama)
# LLM_HOST=http://ollama:11434
# LLM_MODEL=qwen2.5:7b

# STT
# STT_MODEL=base
# STT_LANGUAGE=en

# Server config file path (Docker only)
# SERVER_CONFIG=./server/config.toml
